{
  "": "https://raw.githubusercontent.com/tauri-apps/tauri/refs/heads/v2/crates/tauri-cli/schema.json",
  "productName": "MEMEASY",
  "version": "1.0.0",
  "identifier": "com.memeasy.vault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MEMEASY — Local Media Vault",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright 2026 MEMEASY",
    "shortDescription": "Windows-first Local Media Platform",
    "longDescription": "Local-first photo and video management platform for Windows.",
    "externalBin": [
      "binaries/memeasy-backend"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}